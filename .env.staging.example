# TrendPilot PAPER staging. Copy to .env.staging and fill in. Never commit .env.staging.
# Contains NO exchange credentials: this build has no live adapter and none are read.

# PostgreSQL (container-internal; no host port is published).
POSTGRES_USER=trendpilot
POSTGRES_PASSWORD=
POSTGRES_DB=trendpilot_staging

# Public HTTPS origin. TradingView webhooks need a public domain with a trusted certificate on
# port 443. For a local rehearsal use localhost and STAGING_HTTPS_PORT=8443.
STAGING_DOMAIN=
STAGING_HTTPS_PORT=443
APP_BASE_URL=https://

# 32-byte base64 key sealing MFA secrets at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

SESSION_TTL_HOURS=12
WORKER_POLL_MS=1000

# Public MEXC market data (no key). Empty = https://contract.mexc.com
MEXC_PUBLIC_BASE_URL=
MARKET_FEED_POLL_MS=2000
MARKET_FEED_TIMEOUT_MS=5000

# Retention (days) for finished jobs and old quotes. Fills, exits, funding and ledger are kept.
JOB_RETENTION_DAYS=7
QUOTE_RETENTION_DAYS=7

# Must stay "disabled". Paper only; the services refuse any other value.
LIVE_ORDER_TRANSPORT=disabled

# Outgoing email. Unset = smtp (production default): invites and resets are sent by the worker
# with Admin → Settings → Mail Box, and each delivery failure is shown on that page. Set
# "capture" to keep relaying links by hand with `ops:mail` instead.
# EMAIL_DELIVERY=smtp

# Never set in staging: SIGNAL_TEST_CLOCK, ALLOW_SIGNAL_TEST_CLOCK, DEV_MAILBOX, SEED_PASSWORD,
# DEV_INGRESS_TOKEN, PAPER_SIM_CRASH_AFTER_FILL.
