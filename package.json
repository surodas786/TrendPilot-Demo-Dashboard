{
  "name": "trendpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/domain",
    "packages/db",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @trendpilot/web",
    "build": "npm run build -w @trendpilot/web",
    "worker": "npm run start -w @trendpilot/worker",
    "worker:once": "npm run start -w @trendpilot/worker -- --once",
    "replay": "tsx scripts/replay-tradingview.ts",
    "db:generate": "npm run generate -w @trendpilot/db",
    "db:migrate": "npm run migrate -w @trendpilot/db",
    "db:seed": "npm run seed -w @trendpilot/db",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:demo": "npm --prefix apps/demo install && npm --prefix apps/demo run dev",
    "market:fixture": "npm run market-fixture -w @trendpilot/db --",
    "demo:paper": "npm run demo-paper -w @trendpilot/db --",
    "market:tick": "npm run market-tick -w @trendpilot/db --",
    "market:feed": "npm run feed -w @trendpilot/worker --",
    "market:funding": "npm run market-funding -w @trendpilot/db --",
    "ops:bootstrap-admin": "npm run ops-bootstrap-admin -w @trendpilot/db --",
    "ops:mail": "npm run ops-mail -w @trendpilot/db --",
    "staging:smoke": "tsx scripts/staging-smoke.ts",
    "ops:mexc-readonly-check": "npm run mexc-readonly-check -w @trendpilot/db --",
    "ops:live-preflight": "npm run live-preflight -w @trendpilot/db --",
    "ops:alert-trace": "npm run alert-trace -w @trendpilot/db --"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.1.0",
    "pg": "^8.16.3"
  }
}
