# TrendPilot local environment template. Contains no secrets.
# Copy to .env (cp .env.example .env  |  PowerShell: Copy-Item .env.example .env)

# Local Postgres from docker-compose.yml (host port 5433). Dev-only credentials.
DATABASE_URL=postgres://trendpilot:trendpilot@localhost:5433/trendpilot
DATABASE_URL_TEST=postgres://trendpilot:trendpilot@localhost:5433/trendpilot_test
DATABASE_URL_E2E=postgres://trendpilot:trendpilot@localhost:5433/trendpilot_e2e

# Password given to the seeded fixture users. Dev/test only; seeding refuses NODE_ENV=production.
SEED_PASSWORD=TrendPilot-dev-only-1

# Live private order transport (SRS OPS-02). "disabled" (default) or "enabled".
# "enabled" is accepted ONLY in a production process (NODE_ENV=production, no replay clock, not CI/test);
# dev, demo, CI, test and replay refuse to start with it. Enabling it places no order by itself: Live
# also needs the admin platform switch, an approved investor connection, investor activation and the
# contract allowlist (docs/LIVE_PILOT_RUNBOOK.md).
LIVE_ORDER_TRANSPORT=disabled

# Live: private MEXC sync interval for Live accounts in the worker (balances, positions, fills, stops, drift).
# LIVE_SYNC_MS=30000

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Base URL used to build invite and password-reset links (never taken from request headers).
APP_BASE_URL=http://localhost:3000

# Development email capture: invite/reset emails are stored locally and shown at /dev/mail.
# Never enabled in production regardless of this value.
DEV_MAILBOX=enabled

# Outgoing email: "capture" stores emails in the local outbox only (nothing is sent);
# "smtp" relays them through the worker with Admin → Settings → Mail Box. Default: smtp when
# NODE_ENV=production, capture otherwise. Tests and e2e rely on capture.
# EMAIL_DELIVERY=capture

# 32-byte base64 key that encrypts MFA secrets at rest. Leave empty in development to use an
# insecure built-in development key (a warning is logged). Required when NODE_ENV=production.
DATA_ENCRYPTION_KEY=

# TradingView webhook ingress token for the seeded development route (dev/test fixture only).
# The seed stores only its SHA-256 hash; production tokens are generated by an admin rotation.
DEV_INGRESS_TOKEN=tvw_dev_only_local_fixture_token_not_for_production_0001

# Worker polling interval for durable jobs (milliseconds).
WORKER_POLL_MS=1000

# Optional controlled clock for TradingView replay (dev/test only). When set, webhook intake and
# the worker treat this fixed UTC time as "now", so `npm run replay` is repeatable. Leave unset
# for real time. Never set in production.
# SIGNAL_TEST_CLOCK=2026-11-08T09:30:03Z

# Public MEXC Futures market data for Paper mode (`npm run market:feed`). Public endpoints only:
# no API key exists or is read. Leave the base URL empty for https://contract.mexc.com.
MEXC_PUBLIC_BASE_URL=
MARKET_FEED_POLL_MS=2000
MARKET_FEED_TIMEOUT_MS=5000
# Ticker transport: "ws" (default) = public Futures WebSocket push.ticker is the primary quote source
# and no routine REST ticker call is made; "rest" = legacy REST polling (rollback only).
MARKET_FEED_TICKER_SOURCE=ws
# Empty = wss://contract.mexc.com/edge
MEXC_PUBLIC_WS_URL=
# REST ticker fallback while a contract has no fresh WebSocket quote: off unless set to "on".
# When on, at most one REST ticker read per contract per MARKET_FEED_REST_FALLBACK_MIN_MS (min 5000);
# such quotes are labelled "REST fallback". A MEXC 510 / HTTP 429 pauses all REST calls for ~60 s.
MARKET_FEED_REST_FALLBACK=off
MARKET_FEED_REST_FALLBACK_MIN_MS=10000
# 1 = log every push.ticker (verification runs only; verbose).
MARKET_FEED_LOG_TICKS=0
# Bitunix public prices and 5m/15m candles in the feed process (stored as BITUNIX_PUBLIC quotes for
# Bitunix instruments only; never mixed with MEXC prices). "auto" (default) starts the Bitunix
# WebSocket as soon as a Bitunix pair is published; "on" also subscribes BITUNIX_WS_SYMBOLS;
# "off" disables it (Bitunix entries then fail as FEED_STALE).
BITUNIX_PUBLIC_WS=auto
# Extra symbols to subscribe (empty in auto = the published Bitunix pairs only).
BITUNIX_WS_SYMBOLS=
# Empty = wss://fapi.bitunix.com/public/ ; REST bases empty = https://fapi.bitunix.com
BITUNIX_PUBLIC_WS_URL=
BITUNIX_PUBLIC_BASE_URL=
BITUNIX_PRIVATE_BASE_URL=
# Worker: read-only Bitunix account sync (private WebSocket + REST reconciliation per verified
# Bitunix connection). "off" disables it. BITUNIX_SYNC_MS = periodic REST reconciliation.
BITUNIX_PRIVATE_SYNC=on
BITUNIX_SYNC_MS=60000
# Empty = wss://fapi.bitunix.com/private/
BITUNIX_PRIVATE_WS_URL=
# Lighter public prices (ticker + market_stats per market ID) and closed 5m/15m candles in the feed
# process, for published Lighter markets (stored as LIGHTER_PUBLIC on Lighter instruments only).
# Ethereum mainnet only. "auto" (default) starts when a Lighter market is published; "off" disables.
LIGHTER_PUBLIC_WS=auto
# Empty = wss://mainnet.zklighter.elliot.ai/stream and https://mainnet.zklighter.elliot.ai (no other
# environment is accepted; a local ws:// / http:// endpoint is allowed outside production for tests).
LIGHTER_PUBLIC_WS_URL=
LIGHTER_PUBLIC_BASE_URL=
# Lighter private account reads (investor Lighter connections). Empty = the connection's environment
# (mainnet https://mainnet.zklighter.elliot.ai). Lighter ORDER submission: see LIGHTER_MAINNET_ORDERS.
LIGHTER_PRIVATE_BASE_URL=
# Worker: scheduled Lighter reconciliation (the manual Sync service) for VERIFIED mainnet Lighter
# connections with Live on or exposure TrendPilot manages. "on" (default) or "off"; cadence in ms.
LIGHTER_PRIVATE_SYNC=on
LIGHTER_SYNC_MS=60000
# Native Lighter stops expire (28 days as placed; ModifyOrder cannot renew them). Hours before
# expiry at which sync flags a stop as due: STOP_EXPIRING drift, new entries halted, operator alert.
# Operator policy, deliberately unset (only expired stops are flagged). Proposed for review: 72.
# LIGHTER_STOP_RENEW_LEAD_HOURS=
# Lighter OFFICIAL TESTNET — isolated local test setup ONLY (npm run ops:lighter-testnet-check).
# "enabled" is refused with NODE_ENV=production and unless DATABASE_URL names a *_test / *_testnet
# database; it never opens mainnet orders. Testnet credentials are set in the shell for one run:
#   LIGHTER_TESTNET_ACCOUNT_INDEX, LIGHTER_TESTNET_API_KEY_INDEX, LIGHTER_TESTNET_API_PRIVATE_KEY
LIGHTER_TESTNET=off
# Empty = https://testnet.zklighter.elliot.ai (separate from LIGHTER_PRIVATE_BASE_URL).
LIGHTER_TESTNET_BASE_URL=
# Lighter Live inputs that Lighter does not provide. Deliberately UNSET: until an operator decides
# them, Lighter entries (and closes, for the close bound) are refused with LIVE_INPUT_UNRESOLVED.
#   LIGHTER_ENTRY_WORST_PRICE_PCT  worst entry price, % beyond the fresh best ask (Long) / bid (Short)
#   LIGHTER_STOP_WORST_PRICE_PCT   worst fill once the native stop triggers, % beyond the trigger
#   LIGHTER_CLOSE_WORST_PRICE_PCT  worst price of a reduce-only market close, % beyond the fresh book
#   LIGHTER_TAKER_FEE_RATE         the account's taker fee as a fraction (0.0002 = 2 bp) for the margin check
# Lighter Live scope (packages/db/src/live/lighterLiveScope.ts). ALL UNSET = Lighter Live disabled.
#   LIGHTER_MAINNET_ORDERS    "enabled" allows Lighter mainnet orders (with LIVE_ORDER_TRANSPORT=enabled).
#                             Kill switch for ALL Lighter orders, closes included; to stop only new
#                             entries, remove the account/route below or halt entries instead.
#   LIGHTER_LIVE_CONNECTIONS  TrendPilot connection IDs allowed to open Lighter positions (comma-separated)
#   LIGHTER_LIVE_MARKETS      Lighter market IDs allowed for Live (comma-separated; XAU = 92)
#   LIGHTER_LIVE_ROUTES       TradingView signal route IDs whose alerts may open Lighter positions
# Entries also need every Lighter order capability recorded (Admin → Live Trading), admin approval,
# the investor's activation and the contract on the Live allowlist. Check: npm run ops:lighter-readiness
# ops:bitunix-check only: a READ-ONLY Bitunix key, set in the shell for one run, never committed.
# BITUNIX_READONLY_API_KEY=
# BITUNIX_READONLY_SECRET_KEY=
# Admin → Trading Pairs validation: "mexc" = MEXC public Get Contract Info (contract size, tick, steps,
# leverage limits read from the exchange); "fixture" = local fixture catalogue (tests, local demo).
# Empty = "mexc" when NODE_ENV=production, otherwise "fixture".
PAIR_VALIDATION_SOURCE=