# TrendPilot local environment template. Contains no secrets.
# Copy to .env (cp .env.example .env  |  PowerShell: Copy-Item .env.example .env)

# Local Postgres from docker-compose.yml (host port 5433). Dev-only credentials.
DATABASE_URL=postgres://trendpilot:trendpilot@localhost:5433/trendpilot
DATABASE_URL_TEST=postgres://trendpilot:trendpilot@localhost:5433/trendpilot_test
DATABASE_URL_E2E=postgres://trendpilot:trendpilot@localhost:5433/trendpilot_e2e

# Password given to the seeded fixture users. Dev/test only; seeding refuses NODE_ENV=production.
SEED_PASSWORD=TrendPilot-dev-only-1

# Live private order transport. Must stay "disabled" in dev, demo, CI, test and replay (SRS OPS-02).
# The web app and worker refuse to start with any other value in this build.
LIVE_ORDER_TRANSPORT=disabled

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Base URL used to build invite and password-reset links (never taken from request headers).
APP_BASE_URL=http://localhost:3000

# Development email capture: invite/reset emails are stored locally and shown at /dev/mail.
# Never enabled in production regardless of this value.
DEV_MAILBOX=enabled

# 32-byte base64 key that encrypts MFA secrets at rest. Leave empty in development to use an
# insecure built-in development key (a warning is logged). Required when NODE_ENV=production.
DATA_ENCRYPTION_KEY=

# TradingView webhook ingress token for the seeded development route (dev/test fixture only).
# The seed stores only its SHA-256 hash; production tokens are generated by an admin rotation.
DEV_INGRESS_TOKEN=tvw_dev_only_local_fixture_token_not_for_production_0001

# Worker polling interval for durable jobs (milliseconds).
WORKER_POLL_MS=1000

# Optional controlled clock for TradingView replay (dev/test only). When set, webhook intake and
# the worker treat this fixed UTC time as "now", so `npm run replay` is repeatable. Leave unset
# for real time. Never set in production.
# SIGNAL_TEST_CLOCK=2026-11-08T09:30:03Z

# Public MEXC Futures market data for Paper mode (`npm run market:feed`). Public endpoints only:
# no API key exists or is read. Leave the base URL empty for https://contract.mexc.com.
MEXC_PUBLIC_BASE_URL=
MARKET_FEED_POLL_MS=2000
MARKET_FEED_TIMEOUT_MS=5000
